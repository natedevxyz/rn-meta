#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/meta-lib"

EXTENSION="${1:-}"

if [[ -z "$EXTENSION" ]]; then
  echo "Usage: ./scripts/meta-extend <extension>"
  echo "Targets: $(target_agents_csv) global skills"
  echo "Purpose: agent installs rn-meta companion skills when a workflow needs them"
  echo ""
  echo "Available extensions:"
  print_extensions
  echo "  all             Install everything possible for the target agents"
  exit 1
fi

skills_agent_args=()
for agent in "${META_AGENTS[@]}"; do
  skills_agent_args+=(--agent "$agent")
done

install_extension() {
  local extension="$1"
  local source
  local skill
  local provider

  source="$(extension_source "$extension")"
  skill="$(extension_skill "$extension")"
  provider="$(extension_provider "$extension")"

  if extension_has_duplicate_name "$extension"; then
    if extension_has_duplicate_conflict "$extension"; then
      warn_duplicate_collision "$extension"
      return 0
    fi

    if extension_installed_for_all_targets "$extension"; then
      echo "✓ $provider $skill already installed for $(target_agents_csv), skipping"
      return 0
    fi

    echo "Installing $provider $skill from $source..."
    npx --yes skills add "$source" --skill "$skill" --global --yes "${skills_agent_args[@]}"
    return 0
  fi

  if extension_installed_for_all_targets "$extension"; then
    echo "✓ $provider $skill already installed for $(target_agents_csv), skipping"
    return 0
  fi

  echo "Installing $provider $skill from $source..."
  npx --yes skills add "$source" --skill "$skill" --global --yes "${skills_agent_args[@]}"
}

case "$EXTENSION" in
  ui | heroui | dev-client | best-practices | performance | interactions)
    install_extension "$EXTENSION"
    ;;
  all)
    echo "Installing all extensions..."
    for extension in "${META_EXTENSIONS[@]}"; do
      install_extension "$extension"
    done
    ;;
  *)
    echo "❌ Unknown extension: $EXTENSION"
    echo ""
    echo "Available: $(extension_list_csv), all"
    exit 1
    ;;
esac

echo ""
echo "✅ Done: $EXTENSION"
echo ""
echo "Restart your Claude Code and Codex sessions to use the new skill."
