#!/usr/bin/env bash
set -euo pipefail

APP_NAME="${1:-}"
if [[ -z "$APP_NAME" ]]; then
  echo "Usage: ./scripts/meta-start <app-name>"
  exit 1
fi

if [[ -e "$APP_NAME" ]]; then
  echo "Error: '$APP_NAME' already exists."
  exit 1
fi

echo "➡️  Creating Expo app: $APP_NAME"
pnpm create expo-app@latest "$APP_NAME" --template default

cd "$APP_NAME"

echo "➡️  Installing Expo Dev Client"
npx expo install expo-dev-client

echo "➡️  Installing Uniwind + Tailwind v4"
pnpm add uniwind tailwindcss

echo "➡️  Writing global.css"
cat > global.css <<'CSS'
@import 'tailwindcss';
@import 'uniwind';
CSS

echo "➡️  Writing metro.config.js (Uniwind)"
cat > metro.config.js <<'JS'
const { getDefaultConfig } = require('expo/metro-config');
const { withUniwindConfig } = require('uniwind/metro');

const config = getDefaultConfig(__dirname);

module.exports = withUniwindConfig(config, {
  cssEntryFile: './global.css',
});
JS

echo "➡️  Patching app/_layout.tsx to import global.css"
LAYOUT="app/_layout.tsx"
if [[ -f "$LAYOUT" ]]; then
  if ! grep -q "global.css" "$LAYOUT"; then
    tmpfile="$(mktemp)"
    echo "import '../global.css';" > "$tmpfile"
    cat "$LAYOUT" >> "$tmpfile"
    mv "$tmpfile" "$LAYOUT"
  fi
else
  echo "Warning: $LAYOUT not found. Add: import '../global.css'; at the top of your Router entry file."
fi

echo "➡️  Patching app/(tabs)/index.tsx to demo Uniwind"
INDEX="app/(tabs)/index.tsx"
if [[ -f "$INDEX" ]]; then
  node <<'NODE'
const fs = require('fs');
const indexPath = 'app/(tabs)/index.tsx';
let content = fs.readFileSync(indexPath, 'utf8');

if (!content.includes("from 'react-native'") && !content.includes('from "react-native"')) {
  fs.writeFileSync(indexPath, content);
  process.exit(0);
}

if (!/\bText\b/.test(content.match(/import\s+\{[^}]*\}\s+from\s+['"]react-native['"]/)?.[0] || '')) {
  content = content.replace(
    /import\s+\{([^}]*)\}\s+from\s+(['"])react-native\2/,
    (_match, imports, quote) => `import {${imports.trimEnd()}, Text } from ${quote}react-native${quote}`
  );
}

if (!content.includes('Uniwind works!')) {
  content = content.replace(
    '<ThemedText type="subtitle">Step 1: Try it',
    '<Text className="text-green-500 text-xl">Uniwind works!</Text>\n        <ThemedText type="subtitle">Step 1: Try it'
  );
}

fs.writeFileSync(indexPath, content);
NODE
fi

echo ""
echo "✅ Done."
echo ""

# Check platform availability
has_ios=false
has_android=false

if xcrun simctl list devices &>/dev/null; then
  has_ios=true
fi

if command -v emulator &>/dev/null || [[ -n "${ANDROID_HOME:-}" && -x "$ANDROID_HOME/emulator/emulator" ]]; then
  has_android=true
fi

if ! $has_ios && ! $has_android; then
  echo "⚠️  Warning: No iOS Simulator or Android emulator detected"
  echo ""
  echo "   You can still develop, but won't be able to run the app until one is installed."
  echo ""
  echo "   iOS:"
  echo "     1. Install Xcode from the App Store"
  echo "     2. Open Xcode and install additional components"
  echo "     3. Run: open -a Simulator"
  echo ""
  echo "   Android:"
  echo "     1. Install Android Studio: https://developer.android.com/studio"
  echo "     2. Set ANDROID_HOME environment variable"
  echo "     3. Create an emulator in Android Studio → Virtual Device Manager"
  echo ""
fi

echo "Next:"
echo "  1) Build the dev client:"
if $has_ios; then
  echo "     cd $APP_NAME && npx expo run:ios"
elif $has_android; then
  echo "     cd $APP_NAME && npx expo run:android"
else
  echo "     cd $APP_NAME && npx expo run:ios  # (after installing Xcode)"
fi
echo ""
echo "  2) Start Metro (clear cache after config changes):"
echo "     npx expo start --clear"
echo ""
if $has_ios; then
  echo "If the Simulator doesn't open:"
  echo "  open -a Simulator"
  echo "  npx expo run:ios --device"
fi
