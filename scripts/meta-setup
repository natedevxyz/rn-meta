#!/usr/bin/env node

const fs = require('fs');
const path = require('path');

// ANSI colors
const GREEN = '\x1b[32m';
const YELLOW = '\x1b[33m';
const RED = '\x1b[31m';
const RESET = '\x1b[0m';
const BOLD = '\x1b[1m';

const PASS = `${GREEN}✅${RESET}`;
const WARN = `${YELLOW}⚠️${RESET}`;
const FAIL = `${RED}❌${RESET}`;

// Parse args
const args = process.argv.slice(2);
if (args.includes('-h') || args.includes('--help')) {
  console.log(`Usage: ./scripts/meta-setup [project-path] [--json]

Checks rn-meta setup, Expo/RN configuration, native tooling availability, and the UniWind smoke proof.

Examples:
  ./scripts/meta-setup ./my-app
  ./scripts/meta-setup ./my-app --json`);
  process.exit(0);
}
const jsonOutput = args.includes('--json');
const projectPath = args.find(a => !a.startsWith('--')) || '.';

const results = [];
let hasErrors = false;
let hasWarnings = false;

function check(status, message, fix = null) {
  if (status === 'fail') hasErrors = true;
  if (status === 'warn') hasWarnings = true;
  results.push({ status, message, fix });
}

function fileExists(filePath) {
  return fs.existsSync(path.join(projectPath, filePath));
}

function readFile(filePath) {
  try {
    return fs.readFileSync(path.join(projectPath, filePath), 'utf8');
  } catch {
    return null;
  }
}

function readJson(filePath) {
  try {
    return JSON.parse(readFile(filePath));
  } catch {
    return null;
  }
}

function resolveRouterAppRoot() {
  const candidates = ['app', path.join('src', 'app')];

  for (const candidate of candidates) {
    const absolute = path.join(projectPath, candidate);
    if (!fs.existsSync(absolute)) continue;

    const layoutPath = path.join(candidate, '_layout.tsx');
    if (fileExists(layoutPath)) {
      return { appRoot: candidate, layoutPath };
    }

    return { appRoot: candidate, layoutPath: null };
  }

  return null;
}

function globalCssImportFor(appRoot) {
  if (appRoot === 'app') return '../global.css';
  if (appRoot === path.join('src', 'app')) return '../../global.css';
  return null;
}

function componentRootFor(appRoot) {
  if (appRoot === path.join('src', 'app') || fs.existsSync(path.join(projectPath, 'src'))) {
    return path.join('src', 'components');
  }

  return 'components';
}

function homeRouteFor(appRoot) {
  const candidates = [
    path.join(appRoot, '(tabs)', 'index.tsx'),
    path.join(appRoot, 'index.tsx'),
  ];

  return candidates.find(fileExists) || null;
}

// === CHECKS ===

function checkPlatformAvailable() {
  let hasIos = false;
  let hasAndroid = false;

  // Check iOS Simulator
  try {
    require('child_process').execSync('xcrun simctl list devices', { stdio: 'ignore' });
    hasIos = true;
  } catch {}

  // Check Android emulator
  try {
    const androidHome = process.env.ANDROID_HOME || process.env.ANDROID_SDK_ROOT;
    if (androidHome) {
      const fs = require('fs');
      const emulatorPath = path.join(androidHome, 'emulator', 'emulator');
      if (fs.existsSync(emulatorPath)) {
        hasAndroid = true;
      }
    }
    // Also check if emulator is in PATH
    if (!hasAndroid) {
      require('child_process').execSync('which emulator', { stdio: 'ignore' });
      hasAndroid = true;
    }
  } catch {}

  if (hasIos && hasAndroid) {
    check('pass', 'iOS Simulator and Android emulator available');
  } else if (hasIos) {
    check('pass', 'iOS Simulator available');
    check('warn', 'Android emulator not detected', 'To run on Android:\n  1. Install Android Studio: https://developer.android.com/studio\n  2. Set ANDROID_HOME environment variable\n  3. Create an emulator in Android Studio → Virtual Device Manager');
  } else if (hasAndroid) {
    check('pass', 'Android emulator available');
    check('warn', 'iOS Simulator not detected', 'To run on iOS:\n  1. Install Xcode from the App Store\n  2. Open Xcode and install additional components\n  3. Run: open -a Simulator');
  } else {
    check('warn', 'No iOS Simulator or Android emulator detected', 'You need at least one platform to run the app:\n\n  iOS:\n    1. Install Xcode from the App Store\n    2. Open Xcode and install additional components\n    3. Run: open -a Simulator\n\n  Android:\n    1. Install Android Studio: https://developer.android.com/studio\n    2. Set ANDROID_HOME environment variable\n    3. Create an emulator in Android Studio → Virtual Device Manager');
  }
}

function checkIosXcodeDestinations() {
  try {
    require('child_process').execSync('xcodebuild -version', { stdio: 'ignore' });
  } catch {
    return;
  }

  try {
    require('child_process').execSync('xcrun simctl list devices', { stdio: 'ignore' });
  } catch {
    return;
  }

  try {
    const runtimesRaw = require('child_process').execSync('xcrun simctl list runtimes available -j', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
    const runtimes = JSON.parse(runtimesRaw).runtimes || [];
    const iosRuntimes = runtimes.filter(runtime => runtime.platform === 'iOS' || runtime.identifier?.includes('iOS'));

    if (iosRuntimes.length === 0) {
      check('warn', 'No available iOS Simulator runtimes detected', 'Open Xcode → Settings → Platforms and install an iOS Simulator runtime, then retry:\n  npx expo run:ios');
      return;
    }

    const sdksRaw = require('child_process').execSync('xcodebuild -showsdks', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
    const sdkVersions = [...sdksRaw.matchAll(/iphonesimulator([0-9.]+)/g)].map(match => match[1]);
    const runtimeVersions = iosRuntimes.map(runtime => runtime.version).filter(Boolean);
    const hasMatchingRuntime = sdkVersions.length === 0 || sdkVersions.some(sdkVersion => runtimeVersions.includes(sdkVersion));

    if (!hasMatchingRuntime) {
      check('warn', 'Xcode iOS Simulator SDK does not match installed simulator runtimes', `Xcode SDK(s): ${sdkVersions.join(', ')}\nInstalled runtime(s): ${runtimeVersions.join(', ')}\nIf xcodebuild reports unusable destinations, open Xcode → Settings → Platforms and install the matching iOS Simulator runtime.`);
    }
  } catch {
    check('warn', 'Could not inspect iOS Simulator runtimes', 'If expo run:ios fails with a destination error, open Xcode → Settings → Platforms and install a matching iOS Simulator runtime.');
  }
}

function checkExpoProject() {
  const pkg = readJson('package.json');
  if (!pkg) {
    check('fail', 'No package.json found', `Run from an Expo project root, or pass the project path:\n  meta-setup ./my-app`);
    return null;
  }
  const deps = { ...pkg.dependencies, ...pkg.devDependencies };
  if (!deps.expo) {
    check('fail', 'Not an Expo project (expo not in dependencies)', 'This tool is for Expo projects. Create one with:\n  pnpm create expo-app@latest my-app');
    return null;
  }
  check('pass', 'Expo project detected');
  return { pkg, deps };
}

function checkDevClient(deps) {
  if (deps['expo-dev-client']) {
    check('pass', 'expo-dev-client installed');
  } else {
    check('fail', 'expo-dev-client not installed (Meta stack uses dev client, not Expo Go)', 'Install it:\n  npx expo install expo-dev-client\n\nThen rebuild:\n  npx expo run:ios');
  }
}

function checkGlobalCss() {
  if (!fileExists('global.css')) {
    check('fail', './global.css not found', `Create global.css in project root:\n\n  cat > global.css <<'CSS'\n@import 'tailwindcss';\n@import 'uniwind';\nCSS`);
    return false;
  }

  const content = readFile('global.css');
  const hasTailwind = content.includes("@import 'tailwindcss'") || content.includes('@import "tailwindcss"');
  const hasUniwind = content.includes("@import 'uniwind'") || content.includes('@import "uniwind"');

  if (!hasTailwind || !hasUniwind) {
    const missing = [];
    if (!hasTailwind) missing.push("@import 'tailwindcss';");
    if (!hasUniwind) missing.push("@import 'uniwind';");
    check('fail', `./global.css missing imports: ${missing.join(', ')}`, `Add to global.css:\n\n@import 'tailwindcss';\n@import 'uniwind';`);
    return false;
  }

  check('pass', './global.css has correct imports');
  return true;
}

function checkCssTypeDeclarations() {
  const cssCandidates = [
    'css.d.ts',
    'global.d.ts',
    'env.d.ts',
    'src/css.d.ts',
    'src/global.d.ts',
    'src/env.d.ts',
  ];
  const classNameCandidates = [
    'global.d.ts',
    'env.d.ts',
    'src/global.d.ts',
    'src/env.d.ts',
  ];

  const cssDeclaration = cssCandidates.find(candidate => {
    const content = readFile(candidate);
    if (!content) return false;

    const isModuleFile = /^\s*(import|export)\b/m.test(content);
    if (isModuleFile) return false;

    const hasCss = /declare\s+module\s+['"]\*\.css['"]/.test(content);
    const hasModuleCss = /declare\s+module\s+['"]\*\.module\.css['"]/.test(content);
    return hasCss && hasModuleCss;
  });

  const classNameDeclaration = classNameCandidates.find(candidate => {
    const content = readFile(candidate);
    if (!content) return false;

    return /className\??\s*:\s*string/.test(content);
  });

  if (cssDeclaration && classNameDeclaration) {
    check('pass', `${cssDeclaration} declares CSS imports and ${classNameDeclaration} declares className for TypeScript`);
    return true;
  }

  check('fail', 'CSS/className TypeScript declarations not found', `Create css.d.ts in the project root without imports:\n\n  declare module '*.css';\n  declare module '*.module.css';\n\nCreate global.d.ts in the project root for React Native className types:\n\n  import 'react-native';\n\n  declare module 'react-native' {\n    interface ViewProps {\n      className?: string;\n    }\n\n    interface TextProps {\n      className?: string;\n    }\n  }`);
  return false;
}

function checkMetroConfig() {
  if (!fileExists('metro.config.js')) {
    check('fail', './metro.config.js not found', `Create metro.config.js:\n\n  cat > metro.config.js <<'JS'\nconst { getDefaultConfig } = require('expo/metro-config');\nconst { withUniwindConfig } = require('uniwind/metro');\n\nconst config = getDefaultConfig(__dirname);\n\nmodule.exports = withUniwindConfig(config, {\n  cssEntryFile: './global.css',\n});\nJS`);
    return;
  }

  const content = readFile('metro.config.js');

  // Check for wrong import
  if (content.includes('uniwind/config')) {
    check('fail', './metro.config.js uses uniwind/config (wrong)', `Change the import in metro.config.js:\n\n  // Wrong:\n  require('uniwind/config')\n\n  // Correct:\n  require('uniwind/metro')`);
    return;
  }

  // Check for correct import
  if (!content.includes('uniwind/metro')) {
    check('fail', './metro.config.js missing uniwind/metro', `Add Uniwind to metro.config.js:\n\nconst { withUniwindConfig } = require('uniwind/metro');\n\n// Then wrap your config:\nmodule.exports = withUniwindConfig(config, {\n  cssEntryFile: './global.css',\n});`);
    return;
  }

  // Check for cssEntryFile
  if (!content.includes('cssEntryFile')) {
    check('warn', './metro.config.js may be missing cssEntryFile option', `Ensure metro.config.js includes:\n\nmodule.exports = withUniwindConfig(config, {\n  cssEntryFile: './global.css',\n});`);
    return;
  }

  check('pass', './metro.config.js configured for Uniwind');
}

function checkLayoutImport() {
  const router = resolveRouterAppRoot();

  if (!router) {
    check('warn', 'Expo Router app directory not found', 'Expected either app/ or src/app/. If using Expo Router, ensure the app root exists and imports global.css from its _layout.tsx file.');
    return;
  }

  if (!router.layoutPath) {
    check('warn', `${router.appRoot}/_layout.tsx not found`, `If using Expo Router, create ${router.appRoot}/_layout.tsx and import global.css.`);
    return;
  }

  const content = readFile(router.layoutPath);
  if (!content.includes('global.css')) {
    const importPath = globalCssImportFor(router.appRoot);
    check('fail', `${router.layoutPath} does not import global.css`, `Add at the top of ${router.layoutPath}:\n\nimport '${importPath}';`);
    return;
  }

  check('pass', `${router.layoutPath} imports global.css`);
}

function checkUniwindSmokeProof() {
  const router = resolveRouterAppRoot();

  if (!router) {
    check('fail', 'UniWind smoke proof cannot be checked because no Expo Router app root was found', 'Create either app/ or src/app/ and render MetaSmoke from the home route.');
    return;
  }

  const componentPath = path.join(componentRootFor(router.appRoot), 'MetaSmoke.tsx');
  const component = readFile(componentPath);

  if (!component) {
    check('fail', `${componentPath} not found`, `Create ${componentPath} with a visible className-styled smoke element and render it from the home route.`);
    return;
  }

  const hasClassName = /className\s*=/.test(component);
  const hasTestId = component.includes('rn-meta-uniwind-smoke');
  const hasVisibleLabel = component.includes('UniWind works');

  if (!hasClassName || !hasTestId || !hasVisibleLabel) {
    check('fail', `${componentPath} is missing the expected UniWind smoke proof`, 'The component should include className styles, testID="rn-meta-uniwind-smoke", and visible text "UniWind works".');
    return;
  }

  const homeRoute = homeRouteFor(router.appRoot);
  if (!homeRoute) {
    check('fail', 'No Router home route found for UniWind smoke proof', `Expected ${path.join(router.appRoot, 'index.tsx')} or ${path.join(router.appRoot, '(tabs)', 'index.tsx')}.`);
    return;
  }

  const homeContent = readFile(homeRoute) || '';
  if (!homeContent.includes('MetaSmoke') || !homeContent.includes('<MetaSmoke />')) {
    check('fail', `${homeRoute} does not render the UniWind smoke proof`, `Import MetaSmoke from ${componentPath} and render <MetaSmoke /> in the visible home route.`);
    return;
  }

  check('pass', `${homeRoute} renders the UniWind smoke proof`);
}

function checkUniwindInstalled(deps) {
  if (!deps.uniwind) {
    check('fail', 'uniwind not installed', 'Install Uniwind:\n  pnpm add uniwind tailwindcss');
    return false;
  }
  if (!deps.tailwindcss) {
    check('fail', 'tailwindcss not installed (required by Uniwind)', 'Install Tailwind:\n  pnpm add tailwindcss');
    return false;
  }
  check('pass', 'uniwind and tailwindcss installed');
  return true;
}

function checkConflicts(deps) {
  if (deps.nativewind) {
    check('warn', 'nativewind is installed (may conflict with Uniwind)', 'Consider removing nativewind if using Uniwind:\n  pnpm remove nativewind');
  }
}

function checkOptionalDeps(deps) {
  // These are just informational, not errors
  const recommended = [
    { pkg: '@shopify/flash-list', desc: 'FlashList for performant lists' },
    { pkg: '@react-native-async-storage/async-storage', desc: 'AsyncStorage' },
  ];

  // Don't clutter output with optional suggestions in v1
  // Could add --verbose flag later
}

// === MAIN ===

function run() {
  // Check platform availability first (warnings only)
  checkPlatformAvailable();
  checkIosXcodeDestinations();

  const ctx = checkExpoProject();
  if (!ctx) {
    printResults();
    process.exit(1);
  }

  const { deps } = ctx;

  checkDevClient(deps);
  checkUniwindInstalled(deps);
  checkGlobalCss();
  checkCssTypeDeclarations();
  checkMetroConfig();
  checkLayoutImport();
  checkUniwindSmokeProof();
  checkConflicts(deps);

  printResults();

  if (hasErrors) {
    process.exit(1);
  } else if (hasWarnings) {
    process.exit(0);
  } else {
    process.exit(0);
  }
}

function printResults() {
  if (jsonOutput) {
    console.log(JSON.stringify({ results, hasErrors, hasWarnings }, null, 2));
    return;
  }

  console.log(`\n${BOLD}Meta Setup${RESET}\n`);
  console.log(`Project: ${path.resolve(projectPath)}\n`);

  for (const r of results) {
    const icon = r.status === 'pass' ? PASS : r.status === 'warn' ? WARN : FAIL;
    console.log(`${icon} ${r.message}`);
    if (r.fix && r.status !== 'pass') {
      console.log(`\n   ${BOLD}Fix:${RESET}`);
      for (const line of r.fix.split('\n')) {
        console.log(`   ${line}`);
      }
      console.log('');
    }
  }

  console.log('─'.repeat(50));

  if (hasErrors) {
    console.log(`\n${RED}${BOLD}Some checks failed.${RESET} Fix the issues above and run again.\n`);
  } else if (hasWarnings) {
    console.log(`\n${YELLOW}${BOLD}All critical checks passed${RESET} with some warnings.\n`);
  } else {
    console.log(`\n${GREEN}${BOLD}All checks passed!${RESET} Your Meta stack is configured correctly.\n`);
  }

  console.log(`${BOLD}Reminder:${RESET} After any Metro config changes, restart with:\n  npx expo start --clear\n`);
}

run();
