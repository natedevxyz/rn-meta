#!/usr/bin/env bash
set -euo pipefail

PROJECT_PATH="."
FULL_SCAN=false
RUN_TSC=true
WITH_SCORE=false
HAS_SCOPE_ARG=false
HAS_SCORE_ARG=false
POSITIONAL=()
DOCTOR_ARGS=()

usage() {
  cat <<'EOF'
Usage: ./scripts/meta-doctor [project-path] [options] [-- react-doctor-options]

Runs static quality checks for an rn-meta React Native/Expo project:
  1. TypeScript: tsc --noEmit
  2. React Doctor: npx react-doctor@latest --diff --no-score

Options:
  --full        Run React Doctor against the whole project instead of changed files
  --skip-tsc    Skip the TypeScript check
  --with-score  Allow React Doctor score/share behavior instead of passing --no-score
  -h, --help    Show this help

Any other option is passed through to React Doctor.

Examples:
  ./scripts/meta-doctor ./my-app
  ./scripts/meta-doctor ./my-app --full
  ./scripts/meta-doctor ./my-app --category performance --verbose
  ./scripts/meta-doctor ./my-app -- --diff main --json
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --full)
      FULL_SCAN=true
      shift
      ;;
    --skip-tsc)
      RUN_TSC=false
      shift
      ;;
    --with-score)
      WITH_SCORE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      for arg in "$@"; do
        case "$arg" in
          --diff | --diff=* | --staged)
            HAS_SCOPE_ARG=true
            ;;
          --score)
            WITH_SCORE=true
            HAS_SCORE_ARG=true
            ;;
          --no-score)
            HAS_SCORE_ARG=true
            ;;
        esac
      done
      DOCTOR_ARGS+=("$@")
      break
      ;;
    -*)
      DOCTOR_ARGS+=("$1")
      case "$1" in
        --diff | --diff=* | --staged)
          HAS_SCOPE_ARG=true
          ;;
        --score)
          WITH_SCORE=true
          HAS_SCORE_ARG=true
          ;;
        --no-score)
          HAS_SCORE_ARG=true
          ;;
      esac
      case "$1" in
        --category | --project | --diff | --blocking | --cwd)
          if [[ -n "${2:-}" && "${2:-}" != -* ]]; then
            DOCTOR_ARGS+=("$2")
            shift 2
          else
            shift
          fi
          ;;
        *)
          shift
          ;;
      esac
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ ${#POSITIONAL[@]} -gt 0 ]]; then
  PROJECT_PATH="${POSITIONAL[0]}"
fi

if [[ ${#POSITIONAL[@]} -gt 1 ]]; then
  echo "Error: too many positional arguments."
  usage
  exit 1
fi

PROJECT_PATH="$(cd "$PROJECT_PATH" && pwd)"

if [[ ! -f "$PROJECT_PATH/package.json" ]]; then
  echo "Error: no package.json found at $PROJECT_PATH"
  echo "Usage: ./scripts/meta-doctor /path/to/expo-project"
  exit 1
fi

cd "$PROJECT_PATH"

echo "Running rn-meta quality checks in $PROJECT_PATH"
echo ""

if [[ "$RUN_TSC" == true ]]; then
  if [[ -f tsconfig.json ]]; then
    echo "==> TypeScript: tsc --noEmit"
    if [[ -x node_modules/.bin/tsc ]]; then
      node_modules/.bin/tsc --noEmit
    else
      npx --no-install tsc --noEmit
    fi
    echo ""
  else
    echo "Skipping TypeScript: no tsconfig.json found."
    echo ""
  fi
fi

doctor_command=(npx --yes react-doctor@latest)

if [[ "$FULL_SCAN" != true && "$HAS_SCOPE_ARG" != true ]]; then
  doctor_command+=(--diff)
fi

if [[ "$WITH_SCORE" != true && "$HAS_SCORE_ARG" != true ]]; then
  doctor_command+=(--no-score)
fi

doctor_command+=("${DOCTOR_ARGS[@]}")

echo "==> React Doctor: ${doctor_command[*]}"
"${doctor_command[@]}"

echo ""
echo "Quality checks completed."
